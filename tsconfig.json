{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom"],
    "types": ["vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "swiftui-svelte": ["./src/index.ts"],
      "swiftui-svelte/*": ["./src/*.ts"]
    }
  },
  "include": ["src", "example/src", "test", "*.ts", "*.js"]
}
