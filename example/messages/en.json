{
  "$schema": "https://inlang.com/schema/inlang-message-format",
  "tab_todos": "To-dos",
  "tab_playground": "Playground",
  "tab_settings": "Settings",
  "settings_title": "Settings",
  "language_header": "Language",
  "language_label": "Language",
  "language_system": "Same as device",
  "language_footer": "The app uses your device's language unless you choose another one here.",
  "accent_header": "Accent color",
  "accent_blue": "Blue",
  "accent_orange": "Orange",
  "accent_green": "Green",
  "accent_pink": "Pink",
  "goal_header": "Daily goal",
