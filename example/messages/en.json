  "goal_count": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} to-do a day",
        "countPlural=*": "{count} to-dos a day"
      }
    }
  ],
  "goal_progress": "{done} of {goal} done",
  "reminders_header": "Reminders",
  "remind_me": "Remind me",
  "time": "Time",
  "repeat": "Repeat",
  "repeat_daily": "Every day",
  "repeat_weekdays": "Weekdays",
  "repeat_weekends": "Weekends",
  "sound_header": "Sound",
  "volume": "Volume",
  "tone": "Tone",
  "tone_chime": "Chime",
  "tone_glass": "Glass",
  "tone_pulse": "Pulse",
  "device_header": "This device",
  "device_footer": "These values update as you change the device's settings.",
  "appearance": "Appearance",
  "text_size": "Text size",
  "locale": "Locale",
  "layout_direction": "Layout direction",
  "width": "Width",
  "safe_area": "Safe area",
  "safe_area_value": "{top} pt top, {bottom} pt bottom",
  "form_size": "Form size"
}
