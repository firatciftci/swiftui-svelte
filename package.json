{
  "name": "swiftui-svelte",
  "version": "0.2.0",
  "description": "Build iOS apps with Svelte 5, rendered as native SwiftUI views",
  "keywords": [
    "svelte",
    "svelte5",
    "swiftui",
    "ios",
    "custom-renderer",
    "javascriptcore",
    "native"
  ],
  "license": "MIT",
  "author": "Firat Ciftci <2052855+firatciftci@users.noreply.github.com>",
  "homepage": "https://github.com/firatciftci/swiftui-svelte#readme",
  "bugs": "https://github.com/firatciftci/swiftui-svelte/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firatciftci/swiftui-svelte.git"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "dist",
    "template"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "default": "./dist/renderer.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "svelte": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "default": "./dist/env.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "default": "./dist/query.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "default": "./dist/native.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "default": "./dist/eslint.js"
    },
    "./create": {
      "types": "./dist/create.d.ts",
      "default": "./dist/create.js"
    },
    "./elements": {
      "types": "./dist/elements.d.ts"
    },
    "./tsconfig": "./dist/tsconfig.app.json"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "bench": "vite build --mode bench",
    "package": "svelte-package -i src -o dist --tsconfig tsconfig.lib.json && publint --strict && attw --pack --profile esm-only --exclude-entrypoints ./components",
    "prepack": "svelte-package -i src -o dist --tsconfig tsconfig.lib.json",
    "ios:project": "xcodegen generate --spec example/ios/project.yml",
    "check": "pnpm run compile-paraglide && svelte-check --tsconfig ./tsconfig.json",
    "compile-paraglide": "paraglide-js compile --project ./example/project.inlang --outdir ./example/src/paraglide --strategy preferredLanguage baseLocale --silent",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:swift": "xcrun swift test",
    "lint": "knip && eslint . && swiftlint lint --strict --quiet",
    "lint:fix": "knip --fix && eslint --fix . && swiftlint lint --fix --quiet && swiftlint lint --strict --quiet",
    "format": "oxfmt --check && xcrun swift-format lint --strict --recursive Package.swift Sources Tests example/ios/SvelteHost example/ios/SvelteHostUITests template/ios/__APP_NAME__",
    "format:fix": "oxfmt && xcrun swift-format format --in-place --recursive Package.swift Sources Tests example/ios/SvelteHost example/ios/SvelteHostUITests template/ios/__APP_NAME__",
    "release": "bumpp",
    "fixtures": "vite build --config vite.fixtures.config.ts && vite build --config vite.fixtures.config.ts --mode web",
    "elements": "node scripts/elements.ts && oxfmt src/known.ts",
    "template": "xcodegen generate --spec template/ios/project.yml",
    "docs": "node scripts/docs.ts && oxfmt docs/reference.md"
  },
  "peerDependencies": {
    "svelte": "~5.59.0",
    "vite": ">=7"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@arethetypeswrong/cli": "^0.18.5",
    "@inlang/paraglide-js": "3.2.2",
    "@orpc/client": "^1.16.6",
    "@orpc/server": "^1.16.6",
    "@sveltejs/package": "3.0.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tanstack/svelte-query": "^6.4.7",
    "@trpc/client": "^11.31.3",
    "@trpc/server": "^11.31.3",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.1",
    "better-auth": "^1.7.28",
    "bumpp": "^12.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-erasable-syntax-only": "^0.7.2",
    "eslint-plugin-slop": "^0.1.3",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-svelte": "^3.24.1",
    "knip": "^6.48.0",
    "oxfmt": "0.79.0",
    "publint": "^0.3.25",
    "superjson": "^2.2.7",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "svelte-eslint-parser": "^1.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "^5.1.1",
    "ws": "^8.23.0"
  },
  "packageManager": "pnpm@12.23.0",
  "dependencies": {
    "web-streams-polyfill": "^4.5.1"
  },
  "bin": {
    "swiftui-svelte": "./bin/swiftui-svelte.js"
  }
}
