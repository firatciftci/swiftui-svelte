{
  "name": "swiftui-svelte",
  "version": "0.2.0",
  "description": "Render Svelte components as native SwiftUI views",
  "keywords": [
    "svelte",
    "swiftui",
    "ios",
    "custom-renderer",
    "javascriptcore"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firatciftci/swiftui-svelte.git"
  },
  "homepage": "https://github.com/firatciftci/swiftui-svelte#readme",
  "bugs": "https://github.com/firatciftci/swiftui-svelte/issues",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "default": "./dist/renderer.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./elements": {
      "types": "./dist/elements.d.ts"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "bench": "vite build --mode bench",
    "package": "tsc -p tsconfig.lib.json",
    "prepack": "tsc -p tsconfig.lib.json",
    "ios:project": "xcodegen generate --spec example/ios/project.yml",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "format": "oxfmt --check",
    "format:fix": "oxfmt"
  },
  "peerDependencies": {
    "svelte": "^5.59.0",
    "vite": ">=7"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "oxfmt": "0.79.0",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
